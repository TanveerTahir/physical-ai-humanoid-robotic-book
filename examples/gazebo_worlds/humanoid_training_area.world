<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="humanoid_training_area">
    <!-- Physics Engine -->
    <physics name="ode_physics" type="ode">
      <gravity>0 0 -9.8</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Include ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Include sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Training Area Elements -->

    <!-- Walking path with obstacles -->
    <model name="walking_path">
      <pose>0 0 0 0 0 0</pose>
      <link name="path_base">
        <pose>0 0 0 0 0 0</pose>
        <collision name="path_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="path_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <inertial>
          <mass>1e6</mass>
          <inertia>
            <ixx>1e6</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1e6</iyy>
            <iyz>0</iyz>
            <izz>1e6</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Obstacle Course -->
    <!-- Step obstacle -->
    <model name="step_obstacle_1">
      <pose>2 0 0.05 0 0 0</pose>
      <link name="step_link">
        <collision name="step_collision">
          <geometry>
            <box>
              <size>1 1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="step_visual">
          <geometry>
            <box>
              <size>1 1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>0.33</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.33</iyy>
            <iyz>0</iyz>
            <izz>0.17</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Narrow passage -->
    <model name="narrow_passage">
      <pose>-3 0 0 0 0 0</pose>
      <link name="wall_1">
        <pose>-0.5 0 0.5 0 0 0</pose>
        <collision name="wall_1_collision">
          <geometry>
            <box>
              <size>0.1 4 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_1_visual">
          <geometry>
            <box>
              <size>0.1 4 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>20</mass>
          <inertia>
            <ixx>1.33</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.085</iyy>
            <iyz>0</iyz>
            <izz>1.41</izz>
          </inertia>
        </inertial>
      </link>
      <link name="wall_2">
        <pose>0.5 0 0.5 0 0 0</pose>
        <collision name="wall_2_collision">
          <geometry>
            <box>
              <size>0.1 4 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_2_visual">
          <geometry>
            <box>
              <size>0.1 4 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>20</mass>
          <inertia>
            <ixx>1.33</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.085</iyy>
            <iyz>0</iyz>
            <izz>1.41</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Ramp obstacle -->
    <model name="ramp_obstacle">
      <pose>5 0 0 0 0 0.2</pose>
      <link name="ramp_link">
        <collision name="ramp_collision">
          <geometry>
            <mesh>
              <uri>file://meshes/ramp.dae</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="ramp_visual">
          <geometry>
            <mesh>
              <uri>file://meshes/ramp.dae</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.2 1</ambient>
            <diffuse>0.8 0.6 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>15</mass>
          <inertia>
            <ixx>1.0</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.0</iyy>
            <iyz>0</iyz>
            <izz>0.5</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Manipulation objects -->
    <model name="manipulation_table">
      <pose>-6 0 0 0 0 0</pose>
      <link name="table_top">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.5 1 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.5 1 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>25</mass>
          <inertia>
            <ixx>2.6</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>3.9</iyy>
            <iyz>0</iyz>
            <izz>1.3</izz>
          </inertia>
        </inertial>
      </link>
      <link name="table_leg_1">
        <pose>-0.6 0.4 -0.375 0 0 0</pose>
        <collision name="leg_1_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg_1_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.063</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.063</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
      </link>
      <link name="table_leg_2">
        <pose>0.6 0.4 -0.375 0 0 0</pose>
        <collision name="leg_2_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg_2_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.063</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.063</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
      </link>
      <link name="table_leg_3">
        <pose>-0.6 -0.4 -0.375 0 0 0</pose>
        <collision name="leg_3_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg_3_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.063</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.063</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
      </link>
      <link name="table_leg_4">
        <pose>0.6 -0.4 -0.375 0 0 0</pose>
        <collision name="leg_4_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg_4_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.063</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.063</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Small objects for manipulation -->
    <model name="red_cube">
      <pose>-6 0.2 0.8 0 0 0</pose>
      <link name="cube_link">
        <collision name="cube_collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="cube_visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00017</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00017</iyy>
            <iyz>0</iyz>
            <izz>0.00017</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="blue_sphere">
      <pose>-5.8 0.2 0.8 0 0 0</pose>
      <link name="sphere_link">
        <collision name="sphere_collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="sphere_visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>5e-05</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>5e-05</iyy>
            <iyz>0</iyz>
            <izz>5e-05</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Lighting -->
    <light name="training_area_light" type="point">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>