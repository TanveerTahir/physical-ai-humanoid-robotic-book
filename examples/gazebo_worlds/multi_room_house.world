<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="multi_room_house">
    <!-- Physics Engine -->
    <physics name="ode_physics" type="ode">
      <gravity>0 0 -9.8</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.2</sor>
        </solver>
        <constraints>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Include ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Include sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- House Structure -->
    <model name="house_structure">
      <pose>0 0 0 0 0 0</pose>

      <!-- Main floor -->
      <link name="main_floor">
        <pose>0 0 0 0 0 0</pose>
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>10 10 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>10 10 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.5 1</ambient>
            <diffuse>0.7 0.6 0.5 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>1000</mass>
          <inertia>
            <ixx>8333.33</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>8333.33</iyy>
            <iyz>0</iyz>
            <izz>16666.67</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Living room walls -->
      <link name="living_room_wall_1">
        <pose>5 0 1.5 0 0 0</pose>
        <collision name="wall_1_collision">
          <geometry>
            <box>
              <size>0.2 4 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_1_visual">
          <geometry>
            <box>
              <size>0.2 4 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>2.67</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>10.08</iyy>
            <iyz>0</iyz>
            <izz>12.67</izz>
          </inertia>
        </inertial>
      </link>

      <link name="living_room_wall_2">
        <pose>3 2 1.5 0 0 0</pose>
        <collision name="wall_2_collision">
          <geometry>
            <box>
              <size>4 0.2 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_2_visual">
          <geometry>
            <box>
              <size>4 0.2 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>10.08</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>2.67</iyy>
            <iyz>0</iyz>
            <izz>12.67</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Kitchen area -->
      <link name="kitchen_counter">
        <pose>-3 3 0.9 0 0 0</pose>
        <collision name="counter_collision">
          <geometry>
            <box>
              <size>2 1 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="counter_visual">
          <geometry>
            <box>
              <size>2 1 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.7 1</ambient>
            <diffuse>0.8 0.8 0.7 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>30</mass>
          <inertia>
            <ixx>3.92</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>9.33</iyy>
            <iyz>0</iyz>
            <izz>13.07</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Dining room table -->
      <model name="dining_table">
        <pose>0 -3 0.75 0 0 0</pose>
        <link name="table_top">
          <collision name="top_collision">
            <geometry>
              <box>
                <size>1.5 0.8 0.05</size>
              </box>
            </geometry>
          </collision>
          <visual name="top_visual">
            <geometry>
              <box>
                <size>1.5 0.8 0.05</size>
              </box>
            </geometry>
            <material>
              <ambient>0.6 0.4 0.2 1</ambient>
              <diffuse>0.6 0.4 0.2 1</diffuse>
            </material>
          </visual>
          <inertial>
            <mass>10</mass>
            <inertia>
              <ixx>0.84</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>1.56</iyy>
              <iyz>0</iyz>
              <izz>2.29</izz>
            </inertia>
          </inertial>
        </link>
        <link name="table_leg_1">
          <pose>-0.6 -0.3 -0.375 0 0 0</pose>
          <collision name="leg_1_collision">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
          </collision>
          <visual name="leg_1_visual">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1</ambient>
              <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
          </visual>
          <inertial>
            <mass>1</mass>
            <inertia>
              <ixx>0.0031</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.0031</iyy>
              <iyz>0</iyz>
              <izz>0.00125</izz>
            </inertia>
          </inertial>
        </link>
        <link name="table_leg_2">
          <pose>0.6 -0.3 -0.375 0 0 0</pose>
          <collision name="leg_2_collision">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
          </collision>
          <visual name="leg_2_visual">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1</ambient>
              <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
          </visual>
          <inertial>
            <mass>1</mass>
            <inertia>
              <ixx>0.0031</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.0031</iyy>
              <iyz>0</iyz>
              <izz>0.00125</izz>
            </inertia>
          </inertial>
        </link>
        <link name="table_leg_3">
          <pose>-0.6 0.3 -0.375 0 0 0</pose>
          <collision name="leg_3_collision">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
          </collision>
          <visual name="leg_3_visual">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1</ambient>
              <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
          </visual>
          <inertial>
            <mass>1</mass>
            <inertia>
              <ixx>0.0031</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.0031</iyy>
              <iyz>0</iyz>
              <izz>0.00125</izz>
            </inertial>
          </inertial>
        </link>
        <link name="table_leg_4">
          <pose>0.6 0.3 -0.375 0 0 0</pose>
          <collision name="leg_4_collision">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
          </collision>
          <visual name="leg_4_visual">
            <geometry>
              <cylinder>
                <radius>0.05</radius>
                <length>0.75</length>
              </cylinder>
            </geometry>
            <material>
              <ambient>0.3 0.3 0.3 1</ambient>
              <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
          </visual>
          <inertial>
            <mass>1</mass>
            <inertia>
              <ixx>0.0031</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.0031</iyy>
              <iyz>0</iyz>
              <izz>0.00125</izz>
            </inertial>
          </inertial>
        </link>
      </model>

      <!-- Sofa in living room -->
      <model name="sofa">
        <pose>4 0 0.4 0 0 0</pose>
        <link name="sofa_base">
          <collision name="sofa_collision">
            <geometry>
              <box>
                <size>1.8 0.8 0.8</size>
              </box>
            </geometry>
          </collision>
          <visual name="sofa_visual">
            <geometry>
              <box>
                <size>1.8 0.8 0.8</size>
              </box>
            </geometry>
            <material>
              <ambient>0.2 0.3 0.8 1</ambient>
              <diffuse>0.2 0.3 0.8 1</diffuse>
            </material>
          </visual>
          <inertial>
            <mass>25</mass>
            <inertia>
              <ixx>4.67</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>9.08</iyy>
              <iyz>0</iyz>
              <izz>13.42</izz>
            </inertia>
          </inertial>
        </link>
      </model>

      <!-- Doorways (no physical barriers to allow robot passage) -->
      <model name="doorway_marker_1">
        <pose>0 5 1 0 0 0</pose>
        <link name="doorway_visual_only">
          <visual name="doorway_frame">
            <geometry>
              <box>
                <size>3 0.1 2</size>
              </box>
            </geometry>
            <material>
              <ambient>0.5 0.5 0.5 1</ambient>
              <diffuse>0.5 0.5 0.5 1</diffuse>
            </material>
          </visual>
          <!-- No collision to allow passage -->
          <inertial>
            <mass>0.001</mass>
            <inertia>
              <ixx>0.001</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.001</iyy>
              <iyz>0</iyz>
              <izz>0.001</izz>
            </inertia>
          </inertial>
        </link>
      </model>

    </model>

    <!-- Furniture and objects for interaction -->

    <!-- Books on counter -->
    <model name="book_1">
      <pose>-3.2 2.8 0.85 0 0 0</pose>
      <link name="book_link">
        <collision name="book_collision">
          <geometry>
            <box>
              <size>0.2 0.01 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="book_visual">
          <geometry>
            <box>
              <size>0.2 0.01 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.2 1</ambient>
            <diffuse>0.8 0.6 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>4.58e-05</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>6.67e-05</iyy>
            <iyz>0</iyz>
            <izz>2.5e-05</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="fruit_bowl">
      <pose>0 -3 0.8 0 0 0</pose>
      <link name="bowl_link">
        <collision name="bowl_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bowl_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.2 1</ambient>
            <diffuse>0.8 0.5 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00117</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00117</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Apple in bowl -->
    <model name="apple">
      <pose>0.05 -3 0.83 0 0 0</pose>
      <link name="apple_link">
        <collision name="apple_collision">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="apple_visual">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.9 0.2 0.2 1</ambient>
            <diffuse>0.9 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>9e-06</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>9e-06</iyy>
            <iyz>0</iyz>
            <izz>9e-06</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Indoor lighting -->
    <light name="living_room_light" type="point">
      <pose>3 0 3 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.2</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="dining_room_light" type="point">
      <pose>0 -3 3 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.2</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>